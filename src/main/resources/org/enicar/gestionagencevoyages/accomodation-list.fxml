<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.enicar.gestionagencevoyages.AccomodationListController">
    <children>
        <Text layoutX="136.0" layoutY="67.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Liste des accomodations">
            <font>
                <Font name="Broadway" size="25.0" />
            </font>
        </Text>
        <TableView fx:id="accTable" layoutX="59.0" layoutY="87.0" prefHeight="242.0" prefWidth="482.0">
            <columns>
                <TableColumn fx:id="nomColumn" text="Nom" />
                <TableColumn fx:id="typeColumn" text="Type" />
                <TableColumn fx:id="adresseColumn" text="Adresse" />
                <TableColumn fx:id="prixColumn" text="Prix Nuit" />
                <TableColumn fx:id="supplementsColumn" text="Options Incluses" />
                <TableColumn fx:id="totalColumn" text="Total" />
            </columns>
        </TableView>
      <HBox alignment="CENTER" layoutX="171.0" layoutY="336.0" prefHeight="42.0" prefWidth="258.0" spacing="30.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleAjouter" text="Ajouter accomodation" />
            <Button mnemonicParsing="false" onAction="#handleRetour" text="Retour" />
         </children>
      </HBox>
    </children>
</AnchorPane>
