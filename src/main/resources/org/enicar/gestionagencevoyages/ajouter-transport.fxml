<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.enicar.gestionagencevoyages.TransportController">
   <children>
      <Text layoutX="159.0" layoutY="77.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Ajouter un transport">
         <font>
            <Font name="Broadway" size="25.0" />
         </font>
      </Text>
      <VBox alignment="TOP_RIGHT" layoutX="158.0" layoutY="113.0" prefHeight="136.0" prefWidth="100.0" spacing="30.0">
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Id: " />
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Prix base:" />
            <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Type:" />
         </children>
      </VBox>
      <VBox layoutX="268.0" layoutY="113.0" prefHeight="136.0" prefWidth="154.0" spacing="20.0">
         <children>
            <TextField fx:id="idField" disable="true" promptText="Auto" />
            <TextField fx:id="prixField" promptText="0.0" />
            <TextField fx:id="typeField" promptText="Ex: Bus, Train..." />
         </children>
      </VBox>
      <HBox alignment="CENTER" layoutX="200.0" layoutY="265.0" prefHeight="46.0" prefWidth="200.0" spacing="30.0">
         <children>
            <Button mnemonicParsing="false" onAction="#handleEnregistrer" text="Enregistrer" />
            <Button mnemonicParsing="false" onAction="#handleRetour" text="Retour" />
         </children>
      </HBox>
   </children>
</AnchorPane>
