<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Text?>
<?import javafx.scene.text.Font?>
<GridPane alignment="CENTER" hgap="10" vgap="10" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" stylesheets="@style.css" fx:controller="org.enicar.gestionagencevoyages.Controllers.ConnexionController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Text layoutX="213" layoutY="82" text="Connexion">
        <font>
            <Font name="Broadway" size="25" />
        </font>
    </Text>
    <Label text="Utilisateur:" GridPane.rowIndex="1" />
    <TextField fx:id="usernameField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
    <Label text="Mot de passe:" GridPane.rowIndex="2" />
    <PasswordField fx:id="passwordField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
    <Button text="Se connecter" onAction="#onLogin" GridPane.columnIndex="1" GridPane.rowIndex="3" />
    <Label fx:id="errorLabel" textFill="red" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
</GridPane>