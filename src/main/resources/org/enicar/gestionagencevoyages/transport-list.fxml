<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.enicar.gestionagencevoyages.TransportListController">
    
    <top>
        <Label text="Liste des Transports" style="-fx-font-size: 18px; -fx-padding: 10;" BorderPane.alignment="CENTER"/>
    </top>
    
    <center>
        <TableView fx:id="transportTable" prefHeight="400" prefWidth="600">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                <TableColumn fx:id="typeColumn" text="Type" prefWidth="200"/>
                <TableColumn fx:id="prixColumn" text="Prix (DT)" prefWidth="100"/>
            </columns>
        </TableView>
    </center>
    
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <children>
                <Button text="Ajouter" onAction="#handleAjouter" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                <Button text="Retour" onAction="#handleRetour"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>
