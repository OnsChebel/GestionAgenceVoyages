<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.enicar.gestionagencevoyages.TransportListController">
    <children>
        <Text layoutX="175.0" layoutY="67.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Liste des Transports">
            <font>
                <Font name="Broadway" size="25.0" />
            </font>
        </Text>

        <TableView fx:id="transportTable" layoutX="59.0" layoutY="100.0" prefHeight="200.0" prefWidth="482.0">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="75.0" text="Id" />
                <TableColumn fx:id="typeColumn" prefWidth="250.0" text="Type de Transport" />
                <TableColumn fx:id="prixColumn" prefWidth="150.0" text="Prix" />
            </columns>
        </TableView>

        <Button layoutX="190.0" layoutY="330.0" mnemonicParsing="false" onAction="#handleRetour" text="Retour" />
        <Button layoutX="280.0" layoutY="330.0" mnemonicParsing="false" onAction="#handleAjouter" text="Ajouter transport" />
    </children>
</AnchorPane>