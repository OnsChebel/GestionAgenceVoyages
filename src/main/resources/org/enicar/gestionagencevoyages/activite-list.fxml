<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.enicar.gestionagencevoyages.ActiviteListController">
    <children>
        <Text layoutX="210.0" layoutY="67.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Liste des Activités">
            <font>
                <Font name="Broadway" size="25.0" />
            </font>
        </Text>

        <TableView fx:id="activiteTable" layoutX="26.0" layoutY="100.0" prefHeight="200.0" prefWidth="600.0">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="50.0" text="Id" />
                <TableColumn fx:id="intituleColumn" prefWidth="150.0" text="Intitulé" />
                <TableColumn fx:id="dateColumn" prefWidth="100.0" text="Date" />
                <TableColumn fx:id="horaireColumn" prefWidth="75.0" text="Horaire" />
                <TableColumn fx:id="dureeColumn" prefWidth="75.0" text="Durée" />
                <TableColumn fx:id="prixColumn" prefWidth="100.0" text="Prix" />
            </columns>
        </TableView>

        <Button layoutX="200.0" layoutY="330.0" mnemonicParsing="false" onAction="#handleRetour" text="Retour" />
        <Button layoutX="320.0" layoutY="330.0" mnemonicParsing="false" onAction="#handleAjouter" text="Ajouter une activité" />
    </children>
</AnchorPane>