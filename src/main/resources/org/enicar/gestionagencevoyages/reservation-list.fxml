<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.enicar.gestionagencevoyages.ReservationListController">
   <children>
      <Text layoutX="155.0" layoutY="72.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Liste des réservations">
         <font>
            <Font name="Broadway" size="25.0" />
         </font>
      </Text>
      <TableView fx:id="reservationTable" layoutX="113.0" layoutY="100.0" prefHeight="200.0" prefWidth="372.0">
        <columns>
          <TableColumn fx:id="idColumn" prefWidth="93.60003662109375" text="Id Réservation" />
            <TableColumn fx:id="idClient" prefWidth="75.0" text="Id Client" />
          <TableColumn fx:id="dateColumn" prefWidth="125.5999755859375" text="Date de Réservation" />
            <TableColumn fx:id="statutColumn" prefWidth="75.0" text="Statut" />
        </columns>
      </TableView>
      <HBox alignment="CENTER" layoutX="154.0" layoutY="348.0" prefHeight="43.0" prefWidth="290.0" spacing="30.0">
         <children>
            <Button fx:id="ajouterReservationButton" mnemonicParsing="false" onAction="#handleAjouterReservationAction" text="Ajouter une réservation" />
            <Button fx:id="menuButton" mnemonicParsing="false" onAction="#handleMenuAction" text="Menu principal" />
         </children>
      </HBox>
      <HBox alignment="CENTER" layoutX="25.0" layoutY="314.0" prefHeight="28.0" prefWidth="566.0" spacing="30.0">
         <children>
            <Button fx:id="gererVolsButton" onAction="#handleVoirVols" text="Gérer Vols" />
            <Button onAction="#handleVoirAccomodations" text="Gérer accomodations" />
            <Button onAction="#handleVoirActivites" text="Gérer activités" />
            <Button onAction="#handleVoirTransports" text="Gérer transport" />
         </children>
      </HBox>
   </children>
</AnchorPane>
