<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1" stylesheets="@style.css" fx:controller="org.enicar.gestionagencevoyages.Controllers.ActiviteController" prefWidth="400" prefHeight="400">
    <children>
        <Text text="Ajouter une Activité" layoutX="80" layoutY="40">
            <font>
                <Font size="24"/>
            </font>
        </Text>

        <Label text="Intitulé:" layoutX="50" layoutY="80"/>
        <TextField fx:id="intituleField" layoutX="150" layoutY="75" prefWidth="200"/>

        <Label text="Prix:" layoutX="50" layoutY="120"/>
        <TextField fx:id="prixField" layoutX="150" layoutY="115" prefWidth="200"/>

        <Label text="Jour:" layoutX="50" layoutY="160"/>
        <TextField fx:id="jourField" layoutX="150" layoutY="155" prefWidth="50"/>

        <Label text="Mois:" layoutX="220" layoutY="160"/>
        <TextField fx:id="moisField" layoutX="270" layoutY="155" prefWidth="50"/>

        <Label text="Année:" layoutX="50" layoutY="200"/>
        <TextField fx:id="anneeField" layoutX="150" layoutY="195" prefWidth="100"/>

        <Label text="Horaire:" layoutX="50" layoutY="240"/>
        <TextField fx:id="horaireField" layoutX="150" layoutY="235" prefWidth="100"/>

        <Label text="Durée:" layoutX="50" layoutY="280"/>
        <TextField fx:id="dureeField" layoutX="150" layoutY="275" prefWidth="100"/>

        <HBox layoutX="80" layoutY="330" spacing="20">
            <children>
                <Button text="Ajouter" fx:id="ajouterButton" onAction="#handleAjouter" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                <Button text="Retour" onAction="#handleRetour"/>
            </children>
        </HBox>
    </children>
</AnchorPane>
