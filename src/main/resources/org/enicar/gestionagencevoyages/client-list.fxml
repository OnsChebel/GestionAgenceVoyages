<AnchorPane prefHeight="400.0" prefWidth="600.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.enicar.gestionagencevoyages.Controllers.ClientListController">
   <children>
      <Text layoutX="195.0" layoutY="82.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Liste des clients">
         <font>
            <Font name="Broadway" size="25.0" />
         </font>
      </Text>
      <TableView fx:id="clientTable" layoutX="16.0" layoutY="108.0" prefHeight="200.0" prefWidth="566.0">
         <columns>
            <TableColumn fx:id="idColumn" prefWidth="124.80001831054688" text="Id Personne" />
            <TableColumn fx:id="nomColumn" prefWidth="86.4000244140625" text="Nom" />
            <TableColumn fx:id="prenomColumn" prefWidth="97.5999755859375" text="Prénom" />
            <TableColumn fx:id="coordColumn" prefWidth="119.20001220703125" text="Coordonnées" />
            <TableColumn fx:id="adresseColumn" prefWidth="138.39996337890625" text="Adresse" />
         </columns>
      </TableView>
      <HBox alignment="CENTER" layoutX="63.0" layoutY="329.0" prefHeight="36.0" prefWidth="474.0" spacing="30.0">
         <children>
            <Button fx:id="reservationsButton" mnemonicParsing="false" onAction="#handleReservationsAction" text="Gérer les réservations" />
